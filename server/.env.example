# AshvaTrace server configuration.
# Copy to server/.env (never commit the real file) and fill in the values.
#   cp server/.env.example server/.env

# --- Server ---------------------------------------------------------------
# Port the Express server listens on. Cloud Run injects PORT itself.
PORT=8080

# --- Google Cloud (required for Gemini + BigQuery) -------------------------
# Your GCP project id. If unset, the server still starts: BigQuery persistence
# is skipped (in-memory only) and AI calls fail with a clear error.
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Local development only: path to a service-account key with the roles listed
# in the README. Leave blank to use `gcloud auth application-default login`.
# On Cloud Run, leave this unset: the attached service account is used.
# Never commit the key file (the .gitignore already blocks it).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Gemini (Vertex AI) ----------------------------------------------------
# Model used for investigation, critique, simulation, vision and chat.
GEMINI_MODEL=gemini-3.8-flash
# Used only to turn real token usage into the per-incident AI cost shown in the
# UI. Update to match your model's published pricing (USD per 1M tokens).
GEMINI_INPUT_USD_PER_1M=0.10
GEMINI_OUTPUT_USD_PER_1M=0.40

# --- Persistence -----------------------------------------------------------
# BigQuery dataset for machines, incidents, alerts, layouts and SOPs.
# Created automatically on first start if it does not exist.
BIGQUERY_DATASET=ashvatrace

# --- Optional --------------------------------------------------------------
# Pub/Sub topic id to publish alerts to. Leave blank to disable.
PUBSUB_ALERT_TOPIC=

# When true, a new critical incident is investigated by Gemini automatically.
# Default false: the engineer clicks "Ask AI".
LIVE_AUTO_INVESTIGATE=false
