{
  "name": "ashvatrace-server",
  "version": "0.2.0",
  "description": "AshvaTrace backend — deterministic analytics + AI investigation",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "build:frontend": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "copy:frontend": "node -e \"const fs=require('fs');fs.rmSync('public',{recursive:true,force:true});fs.cpSync('../frontend/dist','public',{recursive:true});\"",
    "build:all": "npm run build:frontend && npm run copy:frontend && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "ts-node src/eval/run.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.3.0",
    "@google-cloud/pubsub": "^6.3.0",
    "@google-cloud/scheduler": "^6.2.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^2.29.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "google-auth-library": "^11.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
